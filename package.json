{
  "name": "agent-fixture-smoke",
  "version": "0.1.0",
  "description": "Turn agent workflow fixtures into deterministic local smoke evidence.",
  "type": "module",
  "bin": {
    "agent-fixture-smoke": "./bin/agent-fixture-smoke.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "demo",
    "SKILL.md",
    "README.md",
    "docs",
    "fixtures",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/check.js",
    "smoke": "node bin/agent-fixture-smoke.js report fixtures/pass.json --format markdown",
    "test": "node --test",
    "package:smoke": "node scripts/package-smoke.js",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent",
    "fixtures",
    "smoke-test",
    "release-evidence"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/agent-fixture-smoke.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/agent-fixture-smoke/issues"
  },
  "homepage": "https://github.com/rogerchappel/agent-fixture-smoke#readme",
  "engines": {
    "node": ">=20"
  }
}
